        "required": [
          "type"
        ],
        "title": "Action",
        "description": "Browser action to execute before extraction."
      },
      "ActionType": {
        "type": "string",
        "enum": [
          "click",
          "wait",
          "scroll",
          "screenshot",
          "type",
          "press",
          "select",
          "hover",
          "wait_for_selector"
        ],
        "title": "ActionType"
      },

        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "max_depth": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Depth"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "allow_backward_crawling": {
            "type": "boolean",
            "title": "Allow Backward Crawling",
            "default": false
          },
          "allow_external_links": {
            "type": "boolean",
            "title": "Allow External Links",
            "default": false
          },
          "include_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Include Paths"
          },
          "exclude_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclude Paths"
          },
          "scrape_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScrapeOptions"
              },
              {
                "type": "null"
              }
            ]
          },
          "ignore_robots": {
            "type": "boolean",
            "title": "Ignore Robots",
            "description": "Skip robots.txt checks when True",
            "default": false
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook Url",
            "description": "URL to POST job completion/failure notifications"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CrawlRequest",
        "description": "POST /v1/crawl request body."
      },

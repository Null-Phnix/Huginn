# Huginn Environment Configuration
# Copy to .env and fill in values

# ─── API ─────────────────────────────────────────────────────────────
# API key for authenticating requests (generate a strong random string)
HUGINN_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────
HUGINN_HOST=0.0.0.0
HUGINN_PORT=7432

# ─── Logging ─────────────────────────────────────────────────────────
HUGINN_LOG_LEVEL=INFO

# ─── Browser ──────────────────────────────────────────────────────────
# StarSearch is the suite default; Playwright is an explicit compatibility
# fallback for controls that the StarSearch protocol does not expose yet.
HUGINN_BROWSER_BACKEND=starsearch
HUGINN_STARSEARCH_TCP=127.0.0.1:7676
HUGINN_HEADLESS=true
HUGINN_STEALTH_MODE=true

# Optional keyless DNS fallback for Docker Compose. Replace with an owned
# resolver if desired.
HUGINN_DNS_PRIMARY=1.1.1.1
HUGINN_DNS_SECONDARY=9.9.9.9

# ─── Crawl Defaults ──────────────────────────────────────────────────
HUGINN_CRAWL_MAX_DEPTH=3
HUGINN_CRAWL_MAX_PAGES=100
HUGINN_CRAWL_CONCURRENCY=5

# ─── LLM (for extract/distill) ───────────────────────────────────────
HUGINN_LLM_PROVIDER=openai
HUGINN_OPENAI_API_KEY=
HUGINN_ANTHROPIC_API_KEY=
HUGINN_GOOGLE_API_KEY=
HUGINN_OLLAMA_BASE_URL=http://localhost:11434

# ─── Database ─────────────────────────────────────────────────────────
# Path to SQLite database (default: data/huginn.db)
HUGINN_DB_PATH=data/huginn.db

# ─── User Agent ───────────────────────────────────────────────────────
# Identify your crawler (default tracks __version__ — Huginn/{version})
HUGINN_USER_AGENT=Huginn/1.3 (+https://huginn.dev/bot)

# ─── Rate Limiting ───────────────────────────────────────────────────
# Requests per minute per IP (default: 100)
HUGINN_RATE_LIMIT=100/minute

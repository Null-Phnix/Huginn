# Huginn Environment Configuration
# Copy to .env and fill in values

# ─── API ─────────────────────────────────────────────────────────────
# API key for authenticating requests (generate a strong random string)
# Prefer a file so the key does not appear in process listings or Docker env.
HUGINN_API_KEY_FILE=/home/phnix/.config/huginn/api-key
# Compose runs as root while this host bind mount is normally owned by the
# login user. Set this to that numeric UID; direct installs should leave it
# unset so the secret must be owned by the service process.
HUGINN_SECRET_OWNER_UID=1000
# Direct environment value remains supported for non-Compose deployments.
HUGINN_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────
HUGINN_HOST=127.0.0.1
HUGINN_PORT=7432
# Browser-origin access is disabled when empty. Use a comma-separated list of
# trusted origins; wildcard CORS is rejected unless API authentication is set.
HUGINN_CORS_ORIGINS=

# ─── Logging ─────────────────────────────────────────────────────────
HUGINN_LOG_LEVEL=INFO

# ─── Browser ──────────────────────────────────────────────────────────
# StarSearch is the production suite backend. It fails closed unless the
# development-only Playwright fallback is explicitly enabled below.
HUGINN_BROWSER_BACKEND=starsearch
HUGINN_STARSEARCH_TCP=127.0.0.1:7676
# Direct-process token path (inside Compose this is overridden to /run/secrets).
HUGINN_STARSEARCH_TOKEN_FILE=/home/phnix/.config/starsearch/tcp-token
# Host path mounted read-only into the container by Docker Compose.
STARSEARCH_TCP_TOKEN_FILE=/home/phnix/.config/starsearch/tcp-token
HUGINN_HEADLESS=true
HUGINN_STEALTH=true
# Production fails closed on StarSearch errors/unsupported controls. Enable
# only as a deliberate compatibility exception while migrating a feature.
HUGINN_ALLOW_PLAYWRIGHT_FALLBACK=false
# Docker build-time compatibility switch (normally left at 0). Compose passes
# this as a build arg; setting it to 1 downloads a second Chromium runtime.
HUGINN_INSTALL_PLAYWRIGHT_BROWSER=0

# Optional keyless DNS fallback for Docker Compose. Replace with an owned
# resolver if desired.
HUGINN_DNS_PRIMARY=1.1.1.1
HUGINN_DNS_SECONDARY=9.9.9.9

# ─── Network Egress / Proxy ──────────────────────────────────────────
# Direct means the host IP is used. StarSearch fingerprints do not create
# proxy infrastructure or geographic egress.
HUGINN_PROXY_PROVIDER=direct
# For real rotation, set provider=static and mount a root-readable file with
# one http(s):// or socks5:// proxy URL per line. Credentials may be embedded
# in that secret file and are never returned by the API.
# HUGINN_PROXY_URLS_FILE=/home/phnix/.config/huginn/proxy-urls
HUGINN_PROXY_ROTATION=round_robin
HUGINN_PROXY_FAILURE_THRESHOLD=3
HUGINN_PROXY_COOLDOWN_SECONDS=60

# ─── Crawl Defaults ──────────────────────────────────────────────────
HUGINN_MAX_DEPTH=3
HUGINN_MAX_PAGES=100
HUGINN_CONCURRENCY=5

# ─── LLM (for extract/distill) ───────────────────────────────────────
HUGINN_LLM_PROVIDER=openai
HUGINN_OPENAI_API_KEY=
HUGINN_ANTHROPIC_API_KEY=
HUGINN_GOOGLE_API_KEY=
HUGINN_OLLAMA_BASE_URL=http://localhost:11434

# ─── Database ─────────────────────────────────────────────────────────
# Path to SQLite database (default: data/huginn.db)
HUGINN_DB_PATH=data/huginn.db

# ─── User Agent ───────────────────────────────────────────────────────
# Identify your crawler (default tracks __version__ — Huginn/{version})
HUGINN_USER_AGENT=Huginn/1.3 (+https://huginn.dev/bot)

# ─── Rate Limiting ───────────────────────────────────────────────────
# Requests per minute per IP (default: 100)
HUGINN_RATE_LIMIT=100/minute
